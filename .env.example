# Jarvix configuration template.
# Copy to .env and fill in the blanks:  copy .env.example .env
# .env and secrets/ are gitignored - never commit real keys.

# ---------------------------------------------------------------------------
# OpenAI - the brain (app/brain/llm_client.py): intent classification fallback,
# calendar-candidate extraction, email/news summarization, question answering,
# and the embeddings used for RAG memory (app/memory/db.py). Also the primary
# TTS voice (app/voice/tts.py).
#   platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# News - app/tools/news.py (NewsAPI.org top-headlines, intent NEWS).
#   newsapi.org -> Get API Key
# ---------------------------------------------------------------------------
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Web search - reserved, not wired into any tool. Tavily is built for LLM
# agents (concise, citation-friendly results); SerpAPI/Bing are drop-in
# alternatives. Opportunity search (below) uses Exa instead, to match the
# provenance of opportunities already in the database.
#   tavily.com -> dashboard -> API keys
# ---------------------------------------------------------------------------
WEB_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Opportunity search - app/tools/websearch.py (Exa), intent FIND_OPPORTUNITIES
# ("find opportunities for me"). Results are inserted into `opportunities`
# with source='exa', matching the existing rows in that table.
#   dashboard.exa.ai -> API Keys
# ---------------------------------------------------------------------------
EXA_API_KEY=

# ---------------------------------------------------------------------------
# Background autopilot - app/runtime/scheduler.py. Runs alongside the wake
# listener (starts as soon as `wake` launches, no separate process to start).
# AUTOPILOT_ENABLED gates the whole scheduler. The per-job flags only gate
# whether that job's DB write happens - email extraction runs either way
# since one combined LLM call covers both event-signup and application
# detection per email (cheaper than two separate calls).
# ---------------------------------------------------------------------------
AUTOPILOT_ENABLED=true
AUTOPILOT_EVENTS=true
AUTOPILOT_APPLICATIONS=true
AUTOPILOT_EMAIL_SCAN_MINUTES=25

# ---------------------------------------------------------------------------
# Postgres (Supabase) - RAG memory + structured capture (app/memory/db/).
# Requires the pgvector extension enabled on the database ("create extension
# vector;" run once, or let init_schema() do it automatically).
# URL-encode special characters in the password (e.g. @ -> %40).
#
# The Supabase project's schema (tasks/projects/progress_events/opportunities/
# events/companies/applications/emails/meetings/people/memories/goals/users/...)
# is expected to already exist - Jarvix only creates the `interactions` table
# it owns and never issues CREATE TABLE against the rest.
# ---------------------------------------------------------------------------
DATABASE_URL=

# USER_ID: the users.id (uuid) row every write is scoped to. Look it up with
# `select id from users where email = '...';` in the Supabase SQL editor.
USER_ID=

# ---------------------------------------------------------------------------
# Google - tools/google_auth.py, gmail.py, calendar.py, email_actions.py
#
# Not a key/secret pair: Google uses a downloaded OAuth client file.
#   1. console.cloud.google.com -> new project
#   2. Enable the Gmail API and the Google Calendar API
#   3. APIs & Services -> Credentials -> Create OAuth client ID -> Desktop app
#   4. Download the JSON, save it as jarvix/secrets/google_credentials.json
# google_token.json is written automatically after the first consent screen.
# Scopes requested: gmail.readonly, gmail.send, calendar.events, calendar.readonly
# ---------------------------------------------------------------------------
GOOGLE_CREDENTIALS_FILE=secrets/google_credentials.json
GOOGLE_TOKEN_FILE=secrets/google_token.json

# ---------------------------------------------------------------------------
# Spotify - tools/music.py
#
# Optional. Without these, music control falls back to Windows media keys;
# search/play-by-name needs the Web API. Blank values raise
# "Spotify API credentials are not configured in .env."
#   1. developer.spotify.com/dashboard -> Create app
#   2. Add the redirect URI below to the app settings (must match exactly)
#   3. Copy the Client ID / Client Secret here
# Scopes requested: user-read-playback-state, user-modify-playback-state
# spotify_token.json is written automatically after the first authorization.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_TOKEN_FILE=secrets/spotify_token.json

# ---------------------------------------------------------------------------
# Weather and time - tools/live_info.py
# Open-Meteo is free and keyless. Only these settings apply.
# ---------------------------------------------------------------------------
TIMEZONE=Europe/Amsterdam
DEFAULT_WEATHER_LOCATION=
WEATHER_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Persona
# ---------------------------------------------------------------------------
USER_DISPLAY_NAME=Sir
JARVIX_GREETING=Welcome back

# ---------------------------------------------------------------------------
# Speech-to-text
# Voice commands (the clip after a confirmed wake) go to AssemblyAI's Sync
# API for speed/accuracy. The always-on wake-word listener stays on local
# faster-whisper (no key, no cloud calls for ambient noise/room chatter).
# tiny.en is fastest for faster-whisper, base.en is more accurate.
#   assemblyai.com/dashboard/api-keys
# ---------------------------------------------------------------------------
STT_MODEL=base.en
STT_LANGUAGE=en
ASSEMBLYAI_API_KEY=
VOICE_RECORD_SECONDS=4
MIC_SILENCE_THRESHOLD=0.0015
WAKE_DEBUG=false

# Wake trigger: wakeword ("hey jarvis") | clap | enter
WAKE_MODE=wakeword
WAKE_WORD=jarvis
CLAP_THRESHOLD=0.06

# ---------------------------------------------------------------------------
# Text-to-speech
# OpenAI's TTS API is primary (uses OPENAI_API_KEY above). Local Windows SAPI
# is the automatic fallback if that call fails - no account needed for it.
# TTS_VOICE_HINTS applies to the SAPI fallback only.
# ---------------------------------------------------------------------------
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_TIMEOUT_SECONDS=15
# OpenAI's speech "speed" param, 0.25-4.0 (1.0 = normal pace).
OPENAI_TTS_SPEED=1.3
TTS_RATE=185
TTS_VOLUME=1.0
TTS_VOICE_HINTS=george,david,male,english,british,uk

# ---------------------------------------------------------------------------
# Wake routine - only safe actions run automatically. Set to "" to disable.
# App/folder names must exist in app/memory/aliases.json.
# ---------------------------------------------------------------------------
AUTO_OPEN_APP_ON_WAKE=vscode
AUTO_OPEN_FOLDER_ON_WAKE=
AUTO_START_MUSIC_ON_WAKE=false
AUTO_MUSIC_QUERY_ON_WAKE=
AUTO_MUSIC_URI_ON_WAKE=

# ---------------------------------------------------------------------------
# Browser control (app/browser/*) - Playwright drives a dedicated, persistent
# Chrome profile, separate from your normal Chrome profile. Run
# `python -m playwright install chrome` once before first use.
# ---------------------------------------------------------------------------
JARVIX_CHROME_PROFILE_DIR=
JARVIX_BROWSER_HEADLESS=false
JARVIX_BROWSER_CHANNEL=chrome
BROWSER_ACTION_TIMEOUT_SECONDS=15
BROWSER_NAV_TIMEOUT_SECONDS=30
MAX_BROWSER_AGENT_STEPS=20

# --- Real-Chrome mode ("auto" by default) -----------------------------------
# Which browser Jarvix drives - dedicated | real | auto:
#   dedicated - ALWAYS use the isolated profile above. Never touches your
#               real Chrome. Starts logged out of everything until you sign
#               in there once (after that it persists).
#   real      - ALWAYS attach to your real running Chrome over CDP. Fails
#               loudly if that's not reachable - use this to catch setup
#               problems, e.g. while testing the --remote-debugging-port flag.
#   auto      - (DEFAULT) tries a fast reachability check against your real
#               Chrome first; if it's not reachable, silently falls back to
#               the isolated profile. No flag-flipping needed - if you launch
#               Chrome with --remote-debugging-port, Jarvix picks it up and
#               uses your existing logins; if you don't, it just works on the
#               isolated profile like before.
#
# Driving your real Chrome removes the profile-isolation safety boundary, so
# whenever it's actually used (mode "real", or "auto" when reachable) it's
# guarded three ways: (1) never silently assumed, (2) every task pauses for
# an explicit "use my real Chrome for this?" approval before anything runs,
# (3) a code-enforced blocklist Jarvix cannot navigate past (banking/
# brokerage/password-manager sites by default).
#
# IMPORTANT: the in-browser "Allow remote debugging for this browser instance"
# toggle (Chrome DevTools MCP) does NOT expose the endpoint Playwright needs.
# Fully quit Chrome, then relaunch it from a terminal with:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="%LOCALAPPDATA%\Google\Chrome\User Data"
JARVIX_BROWSER_MODE=auto
JARVIX_BROWSER_CDP_URL=http://127.0.0.1:9222
# How long "auto" mode's reachability probe waits before falling back to the
# dedicated profile. Kept short - runs on every fresh browser start.
JARVIX_BROWSER_CDP_PROBE_TIMEOUT_SECONDS=1.5
# Protected sites Jarvix is hard-blocked from in real-Chrome mode (substring
# match on the URL). Leave both blank to use the built-in defaults. Set
# JARVIX_BROWSER_BLOCKED_DOMAINS to REPLACE the defaults, or
# JARVIX_BROWSER_EXTRA_BLOCKED_DOMAINS to ADD to them (comma-separated).
JARVIX_BROWSER_BLOCKED_DOMAINS=
JARVIX_BROWSER_EXTRA_BLOCKED_DOMAINS=

# "Open <name>" resolves against your REAL Chrome history (read-only, a
# locked-file-safe copy each time) so "open github" opens what you actually
# use. Leave CHROME_REAL_PROFILE_DIR blank for the default Chrome location.
CHROME_REAL_PROFILE_DIR=
CHROME_REAL_PROFILES=Default,Profile 1,Profile 2

# Applicant profile - filled into job/internship application forms and
# outreach messages the browser agent drafts. A blank field is never
# invented; Jarvix asks you instead.
APPLICANT_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_RESUME_PATH=
APPLICANT_LINKEDIN_URL=
APPLICANT_PORTFOLIO_URL=
