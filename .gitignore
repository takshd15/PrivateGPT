.venv/
__pycache__/
*.pyc

# Local cache (contains private email extraction data)
*.sqlite
*.sqlite3
jarvix_cache.sqlite

.env
secrets/
token*.json
google_token.json
google_credentials.json

# Personal contact data (real emails). Ship contacts.example.json instead.
app/memory/contacts.json

# Background autopilot state (last-run times/counts, local debugging only)
app/memory/autopilot_state.json

# Last-briefing-time tracking (briefing rollup "since last time" cutoff)
app/memory/brief_state.json

# Background run log
jarvix.log

# Browser control (app/browser/*) - persistent Chrome profile (cookies/login
# sessions - never commit), plus screenshots/downloads the browser agent saves.
chrome-profile/
browser_screenshots/
browser_downloads/
